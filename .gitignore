# 只跟踪复现说明和四个实验的关键程序；本地资料、结果、密钥一律不纳入 Git。
/*
!/.gitignore
!/README.md
!/复现说明.md
!/lab01_mlp/
!/lab02_convlstm/
!/lab03_min_llm/
!/lab04_rag/

/lab01_mlp/*
!/lab01_mlp/mlp_digits.py

/lab02_convlstm/*
!/lab02_convlstm/convlstm_bounce.ipynb
!/lab02_convlstm/convlstm_extra_multiball.ipynb

/lab03_min_llm/*
!/lab03_min_llm/min_llm.py
!/lab03_min_llm/min_llm_experiments.ipynb

/lab04_rag/*
!/lab04_rag/hw4_rag.py
!/lab04_rag/hw4_rag_api.py
!/lab04_rag/hw4_rag_experiments.ipynb
!/lab04_rag/hw4_wiki_figure.py

# 新增关键程序时显式加入白名单；不要对整个目录强制 git add -f。
